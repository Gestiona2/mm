---
/**
 * Layout base — lo que se repite en todas las páginas.
 * Menú, pie, botón de tema, aparición al bajar, volver arriba.
 *
 * El contenido de cada página NO se escribe aquí: vive en src/datos/.
 */
import "../styles/global.css";
import sitio from "../datos/sitio.json";
import { ruta } from "../lib/ruta";

interface Props {
  titulo: string;
  descripcion?: string;
  activa?: string;
}
const { titulo, descripcion = sitio.descripcion, activa = "" } = Astro.props;
const camposActivo = ["retail", "constructor", "empresarial", "productor", "btl", "estatal"].includes(activa);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href={ruta("/brand/favicon.png")} />

    <!-- Redes sociales -->
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />

    <!--
      Evita el parpadeo de tema incorrecto.
      Va ANTES de que se pinte nada: si se mueve más abajo, el visitante
      ve un destello blanco al entrar con tema oscuro.
    -->
    <script is:inline define:vars={{ clave: sitio.claveTema }}>
      (function () {
        // Marca que el JS corre: solo entonces el CSS se atreve a ocultar
        // lo que una animación tiene que revelar después.
        document.documentElement.classList.add("js");
        try {
          document.documentElement.setAttribute(
            "data-theme",
            localStorage.getItem(clave) || "light"
          );
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>

  <body>
    <a href="#contenido" class="salta-contenido">Saltar al contenido</a>

    <!-- ==================== MENÚ ==================== -->
    <header class="nav" id="nav">
      <div class="nav-progreso" aria-hidden="true"></div>
      <div class="container nav-inner">
        <a href={ruta("/")} class="nav-logo">
          <img src={ruta("/brand/logo.png")} alt={sitio.nombre} width="180" height="48" />
        </a>

        <nav class="nav-links" id="navLinks">
          {sitio.menu.map((item) => (
            item.despliega ? (
              <div class="nav-item" data-drop>
                <button
                  type="button"
                  class={camposActivo ? "activo con-flecha" : "con-flecha"}
                  aria-expanded="false"
                  aria-controls="submenu-sectores"
                >
                  {item.texto}
                </button>
                <ul class="nav-sub" id="submenu-sectores">
                  {sitio.sectores.map((s) => (
                    <li><a href={ruta(s.href)} class={activa === s.id ? "activo" : ""}>{s.texto}</a></li>
                  ))}
                </ul>
              </div>
            ) : (
              <a href={ruta(item.href)} class={activa === item.id ? "activo" : ""}>{item.texto}</a>
            )
          ))}
          <a href={ruta(sitio.ctaPrincipal.href)} class="btn btn-primary solo-movil">{sitio.ctaPrincipal.texto}</a>
        </nav>

        <div class="nav-actions">
          <button id="botonTema" aria-label="Cambiar entre tema claro y oscuro"></button>
          <a href={ruta(sitio.ctaPrincipal.href)} class="btn btn-primary">{sitio.ctaPrincipal.texto}</a>
          <button id="botonMenu" aria-label="Abrir menú" aria-expanded="false"></button>
        </div>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <!-- ==================== PIE ==================== -->
    <footer class="pie">
      <div class="container">
        <div class="pie-top">
          <div>
            <img class="pie-logo" src={ruta("/brand/logo.png")} alt={sitio.nombre} width="180" height="48" loading="lazy" />
            <p style="max-width:36ch;font-size:.94rem">{sitio.descripcion}</p>
            <div class="pie-redes">
              {sitio.redes.map((r) => (
                <a href={ruta(r.href)} target="_blank" rel="noopener" aria-label={r.nombre}>
                  {r.icono === "facebook" ? (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                    </svg>
                  ) : (
                    <i data-lucide={r.icono}></i>
                  )}
                </a>
              ))}
            </div>
          </div>

          <div>
            <h4>Campos de acción</h4>
            <ul>
              {sitio.sectores.map((s) => <li><a href={ruta(s.href)}>{s.texto}</a></li>)}
            </ul>
          </div>

          <div>
            <h4>Quiénes somos</h4>
            <ul>
              <li><a href={ruta("/nosotros")}>Nosotros</a></li>
              <li><a href={ruta("/contacto")}>Contacto</a></li>
              <li><a href={ruta("/contacto#colombia")}>Bogotá, Colombia</a></li>
              <li><a href={ruta("/contacto#peru")}>Lima, Perú</a></li>
            </ul>
          </div>

          <div>
            <h4>Contacto</h4>
            <ul>
              <li><a href={`https://wa.me/${sitio.whatsapp}`} target="_blank" rel="noopener">WhatsApp Colombia</a></li>
              <li><a href={`tel:${sitio.telefonoColombia.split(" ").join("").replace(/[()]/g, "")}`}>{sitio.telefonoColombia}</a></li>
              <li><a href={`mailto:${sitio.correo}`}>{sitio.correo}</a></li>
              <li>{sitio.direccion}</li>
              <li>{sitio.direccionPeru}</li>
              <li>{sitio.horario}</li>
            </ul>
          </div>
        </div>

        <div class="pie-abajo">
          <p>&copy; {new Date().getFullYear()} {sitio.razonSocial}. Todos los derechos reservados.</p>
          <nav class="pie-legales">
            {sitio.legales.map((l) => <a href={ruta(l.href)}>{l.texto}</a>)}
          </nav>
        </div>
      </div>
    </footer>

    <a
      href={`https://wa.me/${sitio.whatsapp}`}
      class="flota-wa"
      target="_blank"
      rel="noopener"
      aria-label="Escribir por WhatsApp"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
    </a>
    <button class="volver-arriba" id="volverArriba" aria-label="Volver arriba">
      <i data-lucide="arrow-up"></i>
    </button>

    <!--
      Librerías guardadas dentro del sitio, no desde servidores ajenos.
      Privacidad + longevidad. Ver conocimiento/politicas.md.
    -->
    <script is:inline src={ruta("/vendor/lucide/lucide.min.js")}></script>
    <script is:inline src={ruta("/vendor/gsap/gsap.min.js")}></script>
    <script is:inline src={ruta("/vendor/gsap/ScrollTrigger.min.js")}></script>

    <script is:inline define:vars={{ clave: sitio.claveTema }}>
      const $ = (s) => document.querySelector(s);
      const $$ = (s) => Array.from(document.querySelectorAll(s));
      const raiz = document.documentElement;
      const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (window.lucide) lucide.createIcons();

      /* ---------- Tema claro / oscuro ---------- */
      const botonTema = $("#botonTema");
      const pintarBotonTema = () => {
        botonTema.innerHTML =
          raiz.getAttribute("data-theme") === "dark"
            ? '<i data-lucide="sun"></i>'
            : '<i data-lucide="moon"></i>';
        if (window.lucide) lucide.createIcons();
      };
      botonTema?.addEventListener("click", () => {
        const siguiente = raiz.getAttribute("data-theme") === "dark" ? "light" : "dark";
        raiz.setAttribute("data-theme", siguiente);
        try { localStorage.setItem(clave, siguiente); } catch (e) {}
        pintarBotonTema();
      });
      pintarBotonTema();

      /* ---------- Menú en celular ---------- */
      const botonMenu = $("#botonMenu");
      const navLinks = $("#navLinks");
      const cerrarMenu = () => {
        navLinks?.classList.remove("abierto");
        botonMenu?.setAttribute("aria-expanded", "false");
      };
      botonMenu?.addEventListener("click", () => {
        const abierto = navLinks.classList.toggle("abierto");
        botonMenu.setAttribute("aria-expanded", String(abierto));
      });
      // Cerrar al tocar CUALQUIER enlace del menú: si no, en celular
      // el panel queda abierto encima de la página recién cargada.
      $$("#navLinks a").forEach((a) => a.addEventListener("click", cerrarMenu));
      // Cerrar con Escape y al tocar fuera.
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        cerrarMenu();
        $$("[data-drop]").forEach((o) => cerrarSub(o));
      });
      document.addEventListener("click", (e) => {
        if (navLinks?.classList.contains("abierto") &&
            !navLinks.contains(e.target) && !botonMenu?.contains(e.target)) cerrarMenu();
        $$("[data-drop]").forEach((o) => { if (!o.contains(e.target)) cerrarSub(o); });
      });

      /* ---------- Submenú desplegable ----------
         Escritorio: se abre al pasar el cursor y con clic o teclado.
         Celular: SOLO con clic — antes se salía temprano y el submenú
         era inalcanzable, lo que dejaba las 6 páginas de sector sin
         camino desde el menú. */
      function abrirSub(item, abre) {
        const sub = item.querySelector(".nav-sub");
        const disparador = item.querySelector("button");
        if (!sub) return;
        sub.classList.toggle("abierto", abre);
        item.classList.toggle("abierto", abre);
        disparador?.setAttribute("aria-expanded", String(abre));
      }
      function cerrarSub(item) { abrirSub(item, false); }

      $$("[data-drop]").forEach((item) => {
        const disparador = item.querySelector("button");
        const esEscritorio = () => window.innerWidth > 1100;

        item.addEventListener("mouseenter", () => { if (esEscritorio()) abrirSub(item, true); });
        item.addEventListener("mouseleave", () => { if (esEscritorio()) cerrarSub(item); });

        disparador?.addEventListener("click", () => {
          const abierto = item.classList.contains("abierto");
          $$("[data-drop]").forEach(cerrarSub);
          abrirSub(item, !abierto);
        });
        // El submenú también se abre con flecha abajo desde el disparador.
        disparador?.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowDown") return;
          e.preventDefault();
          abrirSub(item, true);
          item.querySelector(".nav-sub a")?.focus();
        });
        // Al salir con el tabulador del último enlace, se cierra.
        item.addEventListener("focusout", (e) => {
          if (esEscritorio() && !item.contains(e.relatedTarget)) cerrarSub(item);
        });
      });

      /* ---------- Apariciones al bajar, con GSAP ---------- */
      if (window.gsap && window.ScrollTrigger && !menosMovimiento) {
        gsap.registerPlugin(ScrollTrigger);
        $$(".reveal").forEach((el) =>
          gsap.to(el, {
            opacity: 1, y: 0, duration: 0.9, ease: "power3.out",
            scrollTrigger: { trigger: el, start: "top 88%" },
          })
        );
        // Parallax suave: data-parallax="0.08" (valores altos marean)
        $$("[data-parallax]").forEach((el) => {
          gsap.to(el, {
            yPercent: -parseFloat(el.dataset.parallax) * 100, ease: "none",
            scrollTrigger: { trigger: el, start: "top bottom", end: "bottom top", scrub: true },
          });
        });
      } else {
        // Sin GSAP o con movimiento reducido: mostrar todo de una vez.
        $$(".reveal").forEach((el) => { el.style.opacity = 1; el.style.transform = "none"; });
      }

      /* ---------- Apariciones en CSS puro ---------- */
      const apariciones = $$(".reveal-up, .reveal-left, .reveal-right, .reveal-pop");
      // Retraso escalonado dentro de un grupo con data-stagger
      $$("[data-stagger]").forEach((grupo) => {
        Array.from(grupo.children).forEach((hijo, i) => hijo.style.setProperty("--i", i));
      });

      if (menosMovimiento || !("IntersectionObserver" in window)) {
        apariciones.forEach((el) => el.classList.add("seen"));
      } else {
        const observador = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((entrada) => {
              if (entrada.isIntersecting) {
                entrada.target.classList.add("seen");
                observador.unobserve(entrada.target);
              }
            });
          },
          { threshold: 0.18, rootMargin: "0px 0px -8% 0px" }
        );
        apariciones.forEach((el) => observador.observe(el));
      }

      /* ---------- Menú con fondo al bajar + volver arriba + barra de progreso ---------- */
      const nav = $("#nav");
      const navProgreso = $(".nav-progreso");
      const volverArriba = $("#volverArriba");
      const hero = document.querySelector(".portada, .encabezado");
      const alBajar = () => {
        const limite = hero ? Math.max(hero.offsetHeight - 80, 0) : 240;
        nav.classList.toggle("bajado", window.scrollY > limite);
        volverArriba.classList.toggle("visible", window.scrollY > 600);
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const progreso = maxScroll > 0 ? Math.min(window.scrollY / maxScroll, 1) : 0;
        navProgreso.style.transform = `scaleX(${progreso})`;
      };
      window.addEventListener("scroll", alBajar, { passive: true });
      alBajar();
      volverArriba?.addEventListener("click", () =>
        window.scrollTo({ top: 0, behavior: menosMovimiento ? "auto" : "smooth" })
      );
    </script>
  </body>
</html>