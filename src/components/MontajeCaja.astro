---
/**
 * El elemento firma de la portada.
 *
 * Llega una caja, se abre, salen las piezas y se arma una mesa. Termina
 * con el logo. Es el negocio entero contado sin una sola frase: el
 * producto llega embalado y Manos Maestras lo deja montado.
 *
 * REGLA CLAVE DE ROBUSTEZ: lo que está dibujado en el SVG es el ESTADO
 * FINAL — la mesa armada. La animación solo parte de ahí hacia atrás
 * (gsap.from). Si GSAP no carga, o el guion falla, el visitante ve la
 * mesa montada y el logo. Nunca un hueco. Es la lección de la portada
 * que se quedó en blanco: nada que deba verse depende de que una
 * animación llegue a completarse.
 *
 * REGLA: aquí NO se escribe texto. Los rótulos salen de
 * src/datos/inicio.json → portada.montaje.rotulos.
 *
 * El dibujo lleva volumen a propósito: cada pieza tiene cara y canto en
 * dos tonos, y hay una sombra en el suelo. A trazo de línea la escena
 * se veía plana.
 */
import { ruta } from "../lib/ruta";
interface Props {
  montaje: { rotulos: string[] };
  nombre: string;
}
const { montaje, nombre } = Astro.props;
---

<div class="montaje" id="montaje">
  <div class="montaje-lienzo">
    <svg viewBox="0 0 440 340" role="img" aria-label="Una caja llega, se abre y sus piezas se arman hasta formar una mesa">
      <defs>
        <linearGradient id="mm-carton" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#e0a978" />
          <stop offset="1" stop-color="#c78a4e" />
        </linearGradient>
      </defs>

      {/* sombra en el suelo: sin esto la mesa flota */}
      <ellipse class="suelo" cx="220" cy="292" rx="128" ry="13" />

      {/* ---------- LA CAJA ----------
          Va ANTES que la mesa a propósito: en SVG lo que se dibuja
          después queda encima, y con la caja delante las piezas salían
          por detrás y no se veían. ---------- */}
      <g class="caja" aria-hidden="true">
        <rect class="caja-cuerpo" x="148" y="192" width="144" height="94" rx="5" fill="url(#mm-carton)" />
        <rect class="caja-cinta" x="212" y="192" width="16" height="94" fill="#b97c42" />
        <rect class="caja-etiqueta" x="164" y="212" width="40" height="26" rx="3" fill="#f6efe6" />
        {/* Las solapas van DESPUÉS del cuerpo: dibujadas antes quedaban
            tapadas por él y la caja parecía no abrirse nunca. */}
        <path class="solapa solapa-izq" d="M146 178 H220 V192 H146 Z" fill="#d1935a" />
        <path class="solapa solapa-der" d="M220 178 H294 V192 H220 Z" fill="#c78a4e" />
      </g>
      {/* ---------- LA MESA (estado final, lo que se ve sin animación) ---------- */}
      <g class="mesa">
        <g class="pieza" data-pieza="pata-tras-izq">
          <rect x="136" y="168" width="11" height="104" rx="3" fill="#b8431a" />
        </g>
        <g class="pieza" data-pieza="pata-tras-der">
          <rect x="293" y="168" width="11" height="104" rx="3" fill="#b8431a" />
        </g>
        <g class="pieza" data-pieza="travesano">
          <rect x="147" y="236" width="146" height="9" rx="3" fill="#c94a1d" />
        </g>
        <g class="pieza" data-pieza="pata-del-izq">
          <rect x="120" y="176" width="14" height="102" rx="4" fill="#e85d26" />
        </g>
        <g class="pieza" data-pieza="pata-del-der">
          <rect x="306" y="176" width="14" height="102" rx="4" fill="#e85d26" />
        </g>
        {/* tablero: cara clara arriba, canto oscuro abajo = volumen */}
        <g class="pieza" data-pieza="tablero">
          <rect x="96" y="146" width="248" height="15" rx="5" fill="#ffb877" />
          <rect x="96" y="159" width="248" height="14" rx="5" fill="#ff9e3c" />
        </g>
        {/* tornillos: el detalle que dice "esto se atornilla" */}
        <circle class="tornillo" cx="127" cy="182" r="3.6" fill="#8a3212" />
        <circle class="tornillo" cx="313" cy="182" r="3.6" fill="#8a3212" />
        <circle class="tornillo" cx="141" cy="241" r="3.2" fill="#8a3212" />
        <circle class="tornillo" cx="299" cy="241" r="3.2" fill="#8a3212" />
      </g>

    </svg>
  </div>

  <div class="montaje-pie">
    <p class="montaje-rotulo" id="montaje-rotulo">
      {montaje.rotulos[montaje.rotulos.length - 1]}
    </p>
    <img
      class="montaje-logo"
      id="montaje-logo"
      src={ruta("/brand/logo.png")}
      alt={nombre}
      width="180"
      height="48"
      loading="eager"
    />
  </div>
</div>

<script is:inline define:vars={{ rotulos: montaje.rotulos }}>
  /* Espera a "load": los guiones de GSAP viven al final del cuerpo, o sea
     DESPUÉS de este componente. Sin esperar, window.gsap aún no existe. */
  window.addEventListener("load", function () {
    const caja = document.getElementById("montaje");
    if (!caja) return;

    const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    /* Sin GSAP o con movimiento reducido no se toca nada: queda la mesa
       armada, el último rótulo y el logo. Que es como se renderizó. */
    if (menosMovimiento || !window.gsap) return;

    const rotulo = document.getElementById("montaje-rotulo");
    const logo = document.getElementById("montaje-logo");
    const q = (s) => caja.querySelector(s);
    const qq = (s) => Array.from(caja.querySelectorAll(s));

    const piezas = qq(".pieza");
    const tornillos = qq(".tornillo");
    const cajaG = q(".caja");

    /* Dónde estaba cada pieza cuando salió de la caja, antes de volar a
       su sitio. Se escriben como desplazamientos desde su posición final,
       así el SVG sigue dibujando la mesa ya montada. */
    const dispersion = {
      /* Comprobado que ninguna cabe fuera del lienzo (0-440 x 0-340):
         con valores mayores las piezas se salían y quedaban cortadas. */
      "tablero":       { x: 0,   y: -78, rotation: -6 },
      "pata-del-izq":  { x: -74, y: -26, rotation: -55 },
      "pata-del-der":  { x: 74,  y: -26, rotation: 55 },
      "pata-tras-izq": { x: -86, y: 44,  rotation: 30 },
      "pata-tras-der": { x: 86,  y: 44,  rotation: -30 },
      "travesano":     { x: 0,   y: 48,  rotation: 8 },
    };

    /* El origen de giro lo pone GSAP, no el CSS: con transformBox/
       transformOrigin de CSS las coordenadas se descuadraban y las piezas
       salían disparadas fuera del lienzo. GSAP lo resuelve nativo en SVG. */
    gsap.set(piezas, { transformOrigin: "50% 50%" });
    /* Cada solapa pivota sobre SU borde exterior, no sobre el centro de
       la caja: con el pivote al revés giraban hacia dentro y parecía que
       la caja se cerraba en lugar de abrirse. */
    gsap.set(q(".solapa-izq"), { transformOrigin: "left bottom" });
    gsap.set(q(".solapa-der"), { transformOrigin: "right bottom" });
    gsap.set(cajaG, { transformOrigin: "50% 100%" });

    const decir = (i) => { if (rotulo) rotulo.textContent = rotulos[i] || rotulos[rotulos.length - 1]; };

    /* Dónde nace cada pieza: dentro de la caja. Se calcula con getBBox,
       que va en unidades del dibujo. Medirlo con getBoundingClientRect
       mezclaba píxeles de pantalla con unidades del SVG y mandaba las
       piezas fuera del lienzo. */
    const bocaCaja = { x: 220, y: 238 };
    const enCaja = (el) => {
      const b = el.getBBox();
      return { x: bocaCaja.x - (b.x + b.width / 2), y: bocaCaja.y - (b.y + b.height / 2) };
    };

    const tl = gsap.timeline({ repeat: -1, repeatDelay: 1.4 });

    /* 1 · Llega la caja */
    tl.set(piezas, {
        opacity: 0, scale: .25, rotation: 0,
        x: (i, el) => enCaja(el).x,
        y: (i, el) => enCaja(el).y,
      })
      .set(tornillos, { opacity: 0, scale: 0 })
      .set(cajaG, { opacity: 1, scale: 1 })
      .set(qq(".solapa"), { rotation: 0 })
      .set(logo, { opacity: 0, y: 10 })
      .call(() => decir(0))
      .from(cajaG, { y: -280, duration: .8, ease: "bounce.out" })

      /* 2 · Se abre */
      .call(() => decir(1))
      .to(q(".solapa-izq"), { rotation: -148, duration: .45, ease: "back.out(1.5)" }, "+=.3")
      .to(q(".solapa-der"), { rotation: 148, duration: .45, ease: "back.out(1.5)" }, "<")

      /* 3 · Salen las piezas y se abren en abanico */
      .call(() => decir(2))
      .to(piezas, {
        opacity: 1, scale: 1,
        x: (i, el) => dispersion[el.dataset.pieza].x,
        y: (i, el) => dispersion[el.dataset.pieza].y,
        rotation: (i, el) => dispersion[el.dataset.pieza].rotation,
        duration: .7, ease: "back.out(1.1)", stagger: .08,
      }, "+=.1")

      /* 4 · La caja se retira y las piezas se ensamblan */
      .to(cajaG, { opacity: 0, scale: .8, duration: .45, ease: "power2.in" }, "-=.3")
      .to(piezas, {
        x: 0, y: 0, rotation: 0,
        duration: .75, ease: "power3.inOut", stagger: .09,
      }, "-=.15")
      .to(tornillos, { opacity: 1, scale: 1, duration: .3, ease: "back.out(2)", stagger: .06 }, "-=.3")

      /* 5 · Queda montada y remata el logo */
      .call(() => decir(3))
      .to(logo, { opacity: 1, y: 0, duration: .5, ease: "power2.out" }, "+=.2")
      .to({}, { duration: 1.8 })
      .to(logo, { opacity: 0, duration: .35 });

    /* No animar en balde con la pestaña en segundo plano. */
    document.addEventListener("visibilitychange", () =>
      document.hidden ? tl.pause() : tl.resume()
    );
  });
</script>
