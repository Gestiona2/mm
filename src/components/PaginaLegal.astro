---
/**
 * Plantilla de página legal (política de privacidad, tratamiento de datos).
 * Recibe los datos por prop. Todo el texto sale del JSON.
 */
import Layout from "../layouts/Layout.astro";

interface Props {
  datos: Record<string, any>;
}
const { datos } = Astro.props;
const { meta, encabezado, secciones } = datos;
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion}>
  <header class="encabezado">
    <div class="encabezado-fondo">
      <img src={encabezado.imagenFondo} alt="" loading="eager" />
    </div>
    <div class="encabezado-velo"></div>
    <div class="container">
      <nav class="miga reveal">
        <a href="/">Inicio</a>
        <span>/</span>
        <span>{encabezado.etiqueta}</span>
      </nav>
      <h1 class="reveal">{encabezado.titulo}</h1>
      <p class="reveal">{encabezado.texto}</p>
    </div>
  </header>

  <section class="pad">
    <div class="container pagina-legal">
      {secciones.map((s) => (
        <div class="reveal">
          <h2>{s.titulo}</h2>
          {s.parrafos.map((p) => <p>{p}</p>)}
        </div>
      ))}
    </div>
  </section>
</Layout>