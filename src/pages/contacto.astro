---
/**
 * Página Contacto.
 * REGLA: aquí NO se escribe texto. Todo sale de src/datos/contacto.json
 * y los datos globales de src/datos/sitio.json.
 * El formulario arma un mensaje y lo abre en WhatsApp (sin backend).
 */
import Layout from "../layouts/Layout.astro";
import datos from "../datos/contacto.json";
import sitio from "../datos/sitio.json";
import { ruta } from "../lib/ruta";

const { meta, encabezado, sedes, formulario } = datos;
const filasTel = (sede) => {
  const partes = [sede.telefono];
  if (sede.lineaNacional) partes.push(`Línea nacional ${sede.lineaNacional}`);
  return partes;
};
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion} activa="contacto">
  {/* ==================== ENCABEZADO ==================== */}
  <header class="encabezado">
    <div class="encabezado-fondo">
      <img src={ruta(encabezado.imagenFondo)} alt="" width="1920" height="1080" loading="eager" fetchpriority="high" />
    </div>
    <div class="encabezado-velo"></div>
    <div class="container">
      <nav class="miga reveal">
        <a href={ruta("/")}>Inicio</a>
        <span>/</span>
        <span>{encabezado.etiqueta}</span>
      </nav>
      <h1 class="reveal">{encabezado.titulo}</h1>
      <p class="reveal">{encabezado.texto}</p>
    </div>
  </header>

  {/* ==================== SEDES ==================== */}
  <section class="pad" id="sedes">
    <div class="container">
      <div class="grid-contacto">
        <div class="contacto-datos" data-stagger>
          {sedes.map((s) => (
            <article class="contacto-tarjeta reveal-up">
              {s.foto && <img src={ruta(s.foto)} alt={`${s.pais} — ${s.ciudad} — ${s.nombre}`} width="700" height="450" style="width:100%;height:auto;border-radius:14px;margin-bottom:16px" loading="lazy" decoding="async" />}
              <h3>
                <span class="icono-caja"><i data-lucide={s.pais === "Perú" ? "map" : "map-pin"}></i></span>
                <span>{s.nombre} · {s.pais}, {s.ciudad}</span>
              </h3>
              <ul>
                <li>{s.direccion}</li>
                {s.referencia && <li><span style="color:var(--text-muted)">{s.referencia}</span></li>}
                {filasTel(s).map((t) => <li>{t}</li>)}
                <li>WhatsApp: {s.whatsapp}</li>
                <li><a href={`mailto:${s.correo}`}>{s.correo}</a></li>
              </ul>
            </article>
          ))}
        </div>

        {/* ==================== FORMULARIO ==================== */}
        <form class="form-caja reveal-right" id="form-contacto" novalidate>
          <span class="eyebrow"><span class="dot"></span> {formulario.encabezado}</span>
          <h2 class="section-title">{formulario.titulo}</h2>
          <p class="lead">{formulario.texto}</p>

          <div class="form-grid">
            {Object.entries(formulario.campos).map(([clave, campo]) => {
              if (campo.opciones) {
                return (
                  <div class="campo ancho">
                    <label for={clave}>{campo.etiqueta} {campo.requerido && <span style="color:var(--marca)">*</span>}</label>
                    <select id={clave} name={clave} required={campo.requerido}>
                      <option value="" disabled selected>Selecciona una opción</option>
                      {campo.opciones.map((o) => <option value={o}>{o}</option>)}
                    </select>
                  </div>
                );
              }
              const esMensaje = clave === "mensaje";
              return (
                <div class:list={["campo", esMensaje && "ancho"]}>
                  <label for={clave}>{campo.etiqueta} {campo.requerido && <span style="color:var(--marca)">*</span>}</label>
                  {esMensaje
                    ? <textarea id={clave} name={clave} placeholder={campo.placeholder} required={campo.requerido}></textarea>
                    : <input
                        id={clave}
                        name={clave}
                        type={clave === "telefono" ? "tel" : clave === "correo" ? "email" : "text"}
                        inputmode={clave === "telefono" ? "tel" : undefined}
                        autocomplete={clave === "nombre" ? "name" : clave === "empresa" ? "organization" : clave === "telefono" ? "tel" : clave === "correo" ? "email" : "on"}
                        placeholder={campo.placeholder}
                        required={campo.requerido}
                      />}
                </div>
              );
            })}

            <div class="ancho">
              <button type="submit" class="btn btn-primary" id="boton-form">
                {formulario.boton}
                <i data-lucide="arrow-right"></i>
              </button>
              <p class="form-nota">{formulario.nota}</p>
              <p class="form-nota">
                ¿Prefieres correo? Escríbenos a
                <a href={`mailto:${sitio.correo}`}>{sitio.correo}</a>
                o llámanos al
                <a href={`tel:${sitio.telefonoColombia.replace(/[^0-9+]/g, "")}`}>{sitio.telefonoColombia}</a>.
              </p>
              <p class="form-aviso" id="form-aviso" role="status" aria-live="polite" hidden></p>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ whatsapp: sitio.whatsapp, correo: sitio.correo }}>
  (function () {
    const form = document.getElementById("form-contacto");
    const boton = document.getElementById("boton-form");
    if (!form) return;

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }

      const datos = Object.fromEntries(new FormData(form).entries());
      const lineas = [
        "Hola, Manos Maestras. Quiero información sobre un proyecto.",
        "",
        `Nombre: ${datos.nombre || "—"}`,
        datos.empresa ? `Empresa: ${datos.empresa}` : "",
        `Celular: ${datos.telefono || "—"}`,
        `Sector: ${datos.sector || "—"}`,
      ].filter(Boolean);
      const mensaje = [...lineas, datos.mensaje ? `Mensaje: ${datos.mensaje}` : ""].filter(Boolean).join("\n");

      const enlace = `https://wa.me/${whatsapp}?text=${encodeURIComponent(mensaje)}`;
      const aviso = document.getElementById("form-aviso");
      const mostrar = (html, error) => {
        if (!aviso) return;
        aviso.innerHTML = html;
        aviso.classList.toggle("error", Boolean(error));
        aviso.hidden = false;
      };

      boton.disabled = true;
      // Muchos navegadores bloquean la ventana nueva. Sin este control el
      // visitante creía haber enviado y no pasaba nada.
      const ventana = window.open(enlace, "_blank", "noopener");
      if (!ventana || ventana.closed || typeof ventana.closed === "undefined") {
        mostrar(
          'Tu navegador bloqueó la ventana de WhatsApp. ' +
          '<a href="' + enlace + '" target="_blank" rel="noopener">Abre el chat aquí</a> ' +
          'o escríbenos a <a href="mailto:' + correo + '?subject=' +
          encodeURIComponent("Nuevo proyecto — " + (datos.nombre || "")) + '&body=' +
          encodeURIComponent(mensaje) + '">' + correo + '</a>.',
          true
        );
      } else {
        mostrar("Listo: abrimos WhatsApp con tu mensaje. Solo falta que le des enviar.");
      }
      setTimeout(() => { boton.disabled = false; }, 2500);
    });
  })();
</script>