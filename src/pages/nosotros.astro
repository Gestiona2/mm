---
/**
 * Página Nosotros.
 * REGLA: aquí NO se escribe texto. Todo sale de src/datos/nosotros.json.
 */
import Layout from "../layouts/Layout.astro";
import datos from "../datos/nosotros.json";

const { meta, encabezado, presentacion, valores, legado, clientes, cta } = datos;
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion} activa="nosotros">
  {/* ==================== ENCABEZADO ==================== */}
  <header class="encabezado">
    <div class="encabezado-fondo">
      <img src={encabezado.imagenFondo} alt="" loading="eager" />
    </div>
    <div class="encabezado-velo"></div>
    <div class="container">
      <nav class="miga reveal">
        <a href="/">Inicio</a>
        <span>/</span>
        <span>{encabezado.etiqueta}</span>
      </nav>
      <h1 class="reveal">{encabezado.titulo}</h1>
      <p class="reveal">{encabezado.texto}</p>
    </div>
  </header>

  {/* ==================== PRESENTACIÓN ==================== */}
  <section class="pad" id="quienes-somos">
    <div class="container grid-nosotros">
      <div class="reveal-left">
        <span class="eyebrow"><span class="dot"></span> {presentacion.encabezado}</span>
        <h2 class="section-title">{presentacion.titulo}</h2>
        <p class="lead">{presentacion.texto}</p>
      </div>
      <img class="foto-redonda reveal-right" src={presentacion.imagen} alt={presentacion.imagenAlt} loading="lazy" />
    </div>
  </section>

  {/* ==================== VALORES ==================== */}
  <section class="pad" id="valores" style="background:var(--bg-soft)">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {valores.encabezado}</span>
      <h2 class="section-title reveal">{valores.titulo}</h2>

      <div class="grid-valores" data-stagger>
        {valores.items.map((v) => (
          <article class="valor reveal-up">
            <div class="icono-caja"><i data-lucide={v.icono}></i></div>
            <h3>{v.titulo}</h3>
            <p>{v.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== LEGADO ==================== */}
  <section class="pad bloque-oscuro" id="legado">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {legado.encabezado}</span>
      <h2 class="section-title reveal">{legado.titulo}</h2>

      <div class="lista-legado" data-stagger>
        {legado.items.map((l) => (
          <li class="reveal-up">
            <div class="icono-caja"><i data-lucide={l.icono}></i></div>
            <div>
              <h3>{l.titulo}</h3>
              <p>{l.texto}</p>
            </div>
          </li>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== CLIENTES ==================== */}
  <div class="clientes">
    <div class="container">
      <div class="titulo">
        <span class="eyebrow reveal"><span class="dot"></span> {clientes.encabezado}</span>
        <h2 class="section-title reveal">{clientes.titulo}</h2>
        <p class="lead reveal">{clientes.texto}</p>
      </div>
    </div>
    <div class="cinta reveal">
      <div class="cinta-pista">
        {[...clientes.logos, ...clientes.logos].map((l, i) => (
          <img key={i} src={l.archivo} alt={l.nombre} loading="lazy" />
        ))}
      </div>
    </div>
  </div>

  {/* ==================== CTA FINAL ==================== */}
  <section class="pad" style="background:var(--bg-soft)">
    <div class="container">
      <div class="cta-final reveal">
        <div class="brillo"></div>
        <h2>{cta.titulo}</h2>
        <p>{cta.texto}</p>
        <div class="acciones">
          {cta.botones.map((b) => (
            <a href={b.href} class={`btn ${b.estilo}`}>{b.texto}</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>