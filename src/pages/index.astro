---
/**
 * Página de inicio.
 *
 * REGLA: aquí NO se escribe texto. Todo sale de src/datos/inicio.json.
 * Si hay que cambiar una palabra, se cambia en el JSON — nunca aquí.
 */
import Layout from "../layouts/Layout.astro";
import datos from "../datos/inicio.json";
import sitio from "../datos/sitio.json";
import { ruta } from "../lib/ruta";
import MontajeCaja from "../components/MontajeCaja.astro";

const { portada, campos, clientes, servicios, cifras, proceso, video, diferentes, cta, meta } = datos;
function rutaWa(destino) {
  if (destino === "wa") return `https://wa.me/${sitio.whatsapp}`;
  return ruta(destino);
}
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion} activa="inicio">
  {/* ==================== PORTADA ==================== */}
  <header class="portada">
    <div class="portada-fondo">
      <img src={ruta(portada.imagenFondo)} alt="" width="1920" height="1280" loading="eager" fetchpriority="high" />
    </div>
    <div class="portada-velo"></div>
    <div class="container portada-grid">
      <div>
        <span class="eyebrow hero-ay"><span class="dot"></span> {portada.encabezado}</span>
        <h1 class="hero-ay">
          {portada.titulo}{" "}
          <span class="marca-text">{portada.tituloAcento}</span>
        </h1>
        <p class="lead hero-ay">{portada.texto}</p>
        <div class="portada-botones hero-ay">
          {portada.botones.map((b) => (
            <a href={rutaWa(b.href)} class={`btn ${b.estilo}`}>{b.texto}</a>
          ))}
        </div>
      </div>
      <div class="portada-visual" data-parallax="0.06">
        <MontajeCaja montaje={portada.montaje} nombre={sitio.nombre} />
        <div class="portada-badge">
          <strong>{portada.badge.numero}</strong>
          <span>{portada.badge.texto}</span>
        </div>
      </div>
    </div>
  </header>

  {/* ==================== CAMPOS DE ACCIÓN ==================== */}
  <section class="pad" id="campos">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {campos.encabezado}</span>
      <h2 class="section-title reveal">{campos.titulo}</h2>
      <p class="lead reveal">{campos.texto}</p>

      <div class="grid-sectores" data-stagger>
        {campos.items.map((s) => (
          <a class="tarjeta-sector reveal-up" href={ruta(s.href)}>
            <div class="foto">
              <img src={ruta(s.imagen)} alt={`${s.titulo} — trabajos realizados por Manos Maestras`} width="600" height="400" loading="lazy" decoding="async" />
            </div>
            <div class="cuerpo">
              <div class="icono-marca"><i data-lucide={s.icono}></i></div>
              <h3>{s.titulo}</h3>
              <p>{s.texto}</p>
              <span class="ver-mas">
                Conocer más
                <i data-lucide="arrow-right"></i>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== CLIENTES ==================== */}
  <div class="clientes">
    <div class="container">
      <div class="titulo">
        <span class="eyebrow reveal"><span class="dot"></span> {clientes.encabezado}</span>
        <h2 class="section-title reveal">{clientes.titulo}</h2>
        <p class="lead reveal">{clientes.texto}</p>
      </div>
    </div>
    <div class="cinta reveal">
      <div class="cinta-pista">
        {[...clientes.logos, ...clientes.logos].map((l, i) => (
          <img key={i} src={ruta(l.archivo)} alt={l.nombre} width="160" height="44" loading="lazy" decoding="async" />
        ))}
      </div>
    </div>
  </div>

  {/* ==================== SERVICIOS POR TAB ==================== */}
  <section class="pad" id="servicios" style="background:var(--bg-soft)">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {servicios.encabezado}</span>
      <h2 class="section-title reveal">{servicios.titulo}</h2>
      <p class="lead reveal">{servicios.texto}</p>

      <div class="tabs reveal">
        <div class="tabs-pestanas" role="tablist" aria-label={servicios.titulo}>
          {servicios.tabs.map((t, i) => (
            <button
              type="button"
              class:list={["tabs-btn", i === 0 && "activa"]}
              data-tab={t.id}
              role="tab"
              id={`tab-${t.id}`}
              aria-controls={`panel-${t.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
            >
              {t.nombre}
            </button>
          ))}
        </div>
        {servicios.tabs.map((t, i) => (
          <div
            class:list={["tabs-panel", i === 0 && "activa"]}
            data-panel={t.id}
            id={`panel-${t.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${t.id}`}
            hidden={i !== 0}
          >
            {t.items.map((s) => (
              <article>
                <div class="icono-mini"><i data-lucide={s.icono}></i></div>
                <h4>{s.titulo}</h4>
                {s.texto && <p class="servicio-tab-texto">{s.texto}</p>}
                <a href={ruta("/contacto")}>
                  Cotizar <i data-lucide="arrow-right"></i>
                </a>
              </article>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== CIFRAS ==================== */}
  <section class="pad cifras">
    <div class="container grid-cifras" data-stagger>
      {cifras.items.map((c) => (
        <div class="reveal-pop">
          <i data-lucide={c.icono}></i>
          <div class="cifra-num" data-contar={c.numero} data-sufijo={c.sufijo}>0</div>
          <p>{c.texto}</p>
        </div>
      ))}
    </div>
  </section>

  {/* ==================== CÓMO TRABAJAMOS ==================== */}
  <section class="pad" id="como-trabajamos" style="background:var(--bg-soft)">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {proceso.encabezado}</span>
      <h2 class="section-title reveal">{proceso.titulo}</h2>
      <p class="lead reveal">{proceso.texto}</p>

      <div class="grid-pasos" data-stagger>
        {proceso.items.map((p, i) => (
          <article class="paso reveal-up">
            <span class="paso-num">0{i + 1}</span>
            <div class="icono-caja"><i data-lucide={p.icono}></i></div>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== VIDEO ====================
       El archivo se sirve desde el propio sitio, no desde YouTube: sin
       terceros y sin cookies. Y solo se descarga cuando el visitante
       toca reproducir — antes de eso pesa lo que pese la miniatura. */}
  <section class="pad" id="video">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {video.encabezado}</span>
      <h2 class="section-title reveal">{video.titulo}</h2>
      <p class="lead reveal">{video.texto}</p>

      <div class="video-caja reveal-up" id="video-caja" data-archivo={ruta(video.archivo)}>
        <button type="button" class="video-disparador" id="video-disparador" aria-label={video.botonAlt}>
          <img
            src={ruta(video.miniatura)}
            alt={video.miniaturaAlt}
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
          />
          <span class="video-play" aria-hidden="true">
            <i data-lucide="play"></i>
          </span>
          <span class="video-duracion" aria-hidden="true">{video.duracion}</span>
        </button>
      </div>
    </div>
  </section>

  {/* ==================== DIFERENCIADORES ==================== */}
  <section class="pad" id="diferentes">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {diferentes.encabezado}</span>
      <h2 class="section-title reveal">{diferentes.titulo}</h2>
      <p class="lead reveal">{diferentes.texto}</p>

      <div class="grid-diferenciales" data-stagger>
        {diferentes.items.map((d) => (
          <article class="diferencial reveal-up">
            <div class="icono-caja"><i data-lucide={d.icono}></i></div>
            <h3>{d.titulo}</h3>
            <p>{d.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== CTA FINAL ==================== */}
  <section class="pad" style="background:var(--bg-soft)">
    <div class="container">
      <div class="cta-final reveal">
        <div class="brillo"></div>
        <span class="eyebrow"><span class="dot"></span> {cta.encabezado}</span>
        <h2>{cta.titulo}</h2>
        <p>{cta.texto}</p>
        <div class="acciones">
          {cta.botones.map((b) => (
            <a href={rutaWa(b.href)} class={`btn ${b.estilo}`}>{b.texto}</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  /* ---------------- Aparición en cascada de la portada ----------------
     Ojo: .hero-ay arranca en opacity:0 desde el CSS. gsap.from() anima
     DESDE 0 hasta el valor actual, que también es 0 — por eso el texto
     de la portada quedaba invisible en producción. Aquí se revela
     primero y se anima después, y hay una red de seguridad por si
     GSAP no llega a cargar. */
  (function () {
    const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const piezas = Array.from(document.querySelectorAll(".portada .hero-ay"));
    if (!piezas.length) return;

    const mostrarTodo = () =>
      piezas.forEach((el) => { el.style.opacity = 1; el.style.transform = "none"; });

    if (menosMovimiento || !window.gsap) { mostrarTodo(); return; }

    gsap.set(piezas, { opacity: 1 });
    const tl = gsap.timeline({ delay: .2 });
    tl.from(".portada .eyebrow", { yPercent: 60, opacity: 0, duration: .6, ease: "power3.out" })
      .from(".portada h1", { yPercent: 90, opacity: 0, duration: .7, ease: "power3.out" }, "-=.4")
      .from(".portada .lead", { y: 22, opacity: 0, duration: .6, ease: "power3.out" }, "-=.3")
      .from(".portada-botones", { y: 28, opacity: 0, duration: .6, ease: "power3.out" }, "-=.3");
    // El montaje NO se anima aquí: tiene su propia secuencia, y animarle
    // la opacidad lo dejaba invisible si esta línea se interrumpía a mitad.

    // Si algo falla a mitad de camino, el texto igual aparece.
    setTimeout(mostrarTodo, 2500);
  })();

  /* ---------------- Video ----------------
     Se cambia la miniatura por el reproductor al primer clic. Si el JS
     no corre, queda la miniatura: nunca un hueco vacío. */
  (function () {
    const caja = document.getElementById("video-caja");
    const disparador = document.getElementById("video-disparador");
    if (!caja || !disparador) return;

    disparador.addEventListener("click", () => {
      const v = document.createElement("video");
      v.src = caja.dataset.archivo;
      v.controls = true;
      v.autoplay = true;
      v.playsInline = true;
      v.preload = "auto";
      v.className = "video-reproductor";
      v.setAttribute("controlslist", "nodownload");
      caja.replaceChildren(v);
      v.focus();
      // Si el navegador bloquea el arranque con sonido, se reintenta
      // en silencio: mejor verlo mudo que ver un cuadro negro quieto.
      const arrancar = v.play();
      if (arrancar && arrancar.catch) {
        arrancar.catch(() => { v.muted = true; v.play().catch(() => {}); });
      }
    }, { once: true });
  })();

  /* ---------------- Servicios por sector ----------------
     Las pestañas ya vienen marcadas desde el servidor: la primera
     activa y las demás con hidden. Si el JS no corre, la sección
     sigue mostrando contenido en vez de quedar en blanco. */
  (function () {
    const botones = Array.from(document.querySelectorAll(".tabs-btn"));
    const paneles = Array.from(document.querySelectorAll(".tabs-panel"));
    if (!botones.length) return;

    const cambiarTab = (id, mover) => {
      botones.forEach((b) => {
        const activa = b.dataset.tab === id;
        b.classList.toggle("activa", activa);
        b.setAttribute("aria-selected", String(activa));
        b.tabIndex = activa ? 0 : -1;
        if (activa && mover) b.focus();
      });
      paneles.forEach((p) => {
        const activa = p.dataset.panel === id;
        p.classList.toggle("activa", activa);
        p.hidden = !activa;
      });
    };

    botones.forEach((b, i) => {
      b.addEventListener("click", () => cambiarTab(b.dataset.tab));
      b.addEventListener("keydown", (e) => {
        const saltos = { ArrowRight: 1, ArrowLeft: -1, Home: "inicio", End: "fin" };
        if (!(e.key in saltos)) return;
        e.preventDefault();
        const salto = saltos[e.key];
        const destino =
          salto === "inicio" ? 0 :
          salto === "fin" ? botones.length - 1 :
          (i + salto + botones.length) % botones.length;
        cambiarTab(botones[destino].dataset.tab, true);
      });
    });
  })();

  (function () {
    /* Contadores: animan de 0 al número final cuando entran en pantalla. */
    const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const nums = Array.from(document.querySelectorAll("[data-contar]"));
    const pintar = (el) => {
      const destino = parseInt(el.dataset.contar, 10) || 0;
      const sufijo = el.dataset.sufijo || "";
      if (menosMovimiento) { el.textContent = destino.toLocaleString("es-CO") + sufijo; return; }
      const inicio = performance.now();
      const paso = (ahora) => {
        const t = Math.min((ahora - inicio) / 1400, 1);
        el.textContent = Math.round(destino * (1 - Math.pow(1 - t, 3))).toLocaleString("es-CO") + sufijo;
        if (t < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    };
    if (nums.length) {
      if (!("IntersectionObserver" in window)) { nums.forEach(pintar); }
      else {
        const io = new IntersectionObserver((es) => {
          es.forEach((e) => { if (e.isIntersecting) { pintar(e.target); io.unobserve(e.target); } });
        }, { threshold: 0.5 });
        nums.forEach((n) => io.observe(n));
      }
    }
  })();
</script>